{
  // Typecheck-only config: same language settings as the build config
  // (tsconfig.json) but additionally covers tests/, which are excluded from
  // the build because emitted files must stay inside rootDir (src/).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "rootDir": "."
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
