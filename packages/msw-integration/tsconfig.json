{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    // The package publishes dist/*.d.ts as its "types" entry, so emit
    // declarations (tsconfig.base keeps noEmit:true for typecheck-only users).
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests"],
  "references": [{ "path": "../core" }]
}
