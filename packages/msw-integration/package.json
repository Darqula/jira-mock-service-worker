{
  "name": "@jira-mock/msw-integration",
  "version": "1.0.0",
  "description": "Mock Service Worker integration for Jira Cloud API",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/setup/browser.d.ts",
      "import": "./dist/setup/browser.js"
    },
    "./node": {
      "types": "./dist/setup/node.d.ts",
      "import": "./dist/setup/node.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jira-mock/core": "*",
    "msw": "^2.6.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^2.1.5",
    "@vitest/ui": "^2.1.5",
    "typescript": "^5.3.3",
    "vitest": "^2.1.5"
  },
  "peerDependencies": {
    "msw": "^2.0.0"
  },
  "keywords": [
    "jira",
    "mock",
    "msw",
    "mock-service-worker",
    "testing"
  ],
  "author": "",
  "license": "MIT"
}
