{
  "name": "@jira-mock/msw-integration",
  "version": "1.0.0",
  "description": "Mock Service Worker integration for Jira Cloud API",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/setup/browser.d.ts",
      "import": "./dist/setup/browser.js"
    },
    "./node": {
      "types": "./dist/setup/node.d.ts",
      "import": "./dist/setup/node.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@faker-js/faker": "^9.0.3",
    "@jira-mock/core": "1.0.0",
    "msw": "^2.6.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^3.2.7",
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1",
    "openapi-types": "^12.1.3",
    "typescript": "^5.3.3",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "msw": "^2.0.0"
  },
  "keywords": [
    "jira",
    "mock",
    "msw",
    "mock-service-worker",
    "testing"
  ],
  "author": "Darqula",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Darqula/jira-mock-service-worker.git"
  },
  "bugs": {
    "url": "https://github.com/Darqula/jira-mock-service-worker/issues"
  },
  "homepage": "https://github.com/Darqula/jira-mock-service-worker#readme"
}
