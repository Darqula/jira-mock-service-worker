{
  "name": "jira-mock-service-worker",
  "version": "1.0.0",
  "description": "Mock Service Worker integration for Jira Cloud API testing and performance benchmarks",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @jira-mock/core && npm run build --workspace @jira-mock/msw-integration && npm run build --workspace @jira-mock/config-ui && npm run build --workspace nextjs-openapi-tester",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.1.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "postcss": "^8.5.26",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "jira",
    "mock",
    "msw",
    "testing",
    "api",
    "mock-service-worker"
  ],
  "author": "Darqula",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Darqula/jira-mock-service-worker.git"
  },
  "bugs": {
    "url": "https://github.com/Darqula/jira-mock-service-worker/issues"
  },
  "homepage": "https://github.com/Darqula/jira-mock-service-worker#readme"
}
